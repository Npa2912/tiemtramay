{
  "name": "tiem-tra-may",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "test:smoke": "node scripts/smoke.mjs",
    "test:accounts": "playwright test --config playwright.accounts.config.ts",
    "build:server": "esbuild src/engine.ts --bundle --format=esm --platform=neutral --outfile=supabase/functions/_shared/engine.js",
    "build:dashboard": "npm run build:server && esbuild supabase/functions/game/index.ts --bundle --format=esm --platform=neutral --outfile=supabase/dashboard/game.ts"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
